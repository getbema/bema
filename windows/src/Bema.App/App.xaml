<Application x:Class="Bema.App.BemaApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Brushes are filled in by Theme.Apply(); these are the Backstage defaults for the designer. -->
        <SolidColorBrush x:Key="Ground" Color="#0E1014"/>
        <SolidColorBrush x:Key="Bar" Color="#12151A"/>
        <SolidColorBrush x:Key="Panel" Color="#15181E"/>
        <SolidColorBrush x:Key="Raised" Color="#181B22"/>
        <SolidColorBrush x:Key="Selected" Color="#2B2F3A"/>
        <SolidColorBrush x:Key="Border" Color="#232731"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#2A2F3A"/>
        <SolidColorBrush x:Key="Text" Color="#E9EBEF"/>
        <SolidColorBrush x:Key="TextBright" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="TextSoft" Color="#C9CED6"/>
        <SolidColorBrush x:Key="Muted" Color="#9BA3AF"/>
        <SolidColorBrush x:Key="Dim" Color="#8A93A0"/>
        <SolidColorBrush x:Key="Accent" Color="#F5A524"/>
        <SolidColorBrush x:Key="AccentInk" Color="#1A1206"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#29F5A524"/>
        <SolidColorBrush x:Key="WarnBg" Color="#2A2113"/>
        <SolidColorBrush x:Key="WarnBorder" Color="#5A4520"/>
        <SolidColorBrush x:Key="WarnText" Color="#D8C9A8"/>
        <SolidColorBrush x:Key="WarnStrong" Color="#FFC35C"/>
        <SolidColorBrush x:Key="Live" Color="#FF5A4F"/>
        <SolidColorBrush x:Key="LiveSoft" Color="#FF8F87"/>
        <SolidColorBrush x:Key="LiveBg" Color="#3A1A1A"/>
        <SolidColorBrush x:Key="Ok" Color="#4BE3A0"/>
        <SolidColorBrush x:Key="OkBg" Color="#16352A"/>
        <SolidColorBrush x:Key="Danger" Color="#FFB4AE"/>
        <SolidColorBrush x:Key="DangerBg" Color="#2A1617"/>

        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Pill buttons: Normal (raised), Accent (amber), Danger (red). -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DangerPill" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Live}"/>
        </Style>

        <!-- Square icon buttons in the top bar. -->
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Ground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Application.Resources>
</Application>
